{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://order-tracker-lulc.onrender.com/api/:path*"
    },
    {
      "source": "/swagger-ui.html",
      "destination": "https://order-tracker-lulc.onrender.com/swagger-ui.html"
    },
    {
      "source": "/swagger-ui/:path*",
      "destination": "https://order-tracker-lulc.onrender.com/swagger-ui/:path*"
    },
    {
      "source": "/v3/api-docs/:path*",
      "destination": "https://order-tracker-lulc.onrender.com/v3/api-docs/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
